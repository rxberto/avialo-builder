// This is your Prisma schema file for Prisma 7
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int      @id @default(autoincrement())
  name                   String
  email                  String   @unique
  passwordHash           String
  profession             String?
  role                   String?
  plan                   String   @default("none")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  createdAt              DateTime @default(now())

  // Configuración de la única página web incluida por cuenta
  siteName               String?
  siteType               String?
  siteDomain             String?
  siteJobId              String?
  siteStatus             String   @default("none") // "none" | "pending" | "generating" | "deployed" | "failed"

  // Ecommerce (Medusa compartido): provisión por tienda. La storefront del cliente
  // usa la publishable key para hablar con el Store API aislada a su Sales Channel.
  medusaSalesChannelId   String?
  medusaPublishableKey   String?
  // Token máquina (secreto) que usa el panel del cliente para gestionar SU tienda vía el
  // orquestador. El orquestador lo valida → mapea a este usuario → su Sales Channel.
  storeMgmtToken         String?  @unique

  // Stripe Connect (cobros de la TIENDA del cliente → a SU cuenta). Avialo es la plataforma;
  // cada pyme conecta su propia cuenta Stripe. Los cobros de la storefront se enrutan a esta
  // cuenta (destination charges). NO guardamos claves secretas del cliente: Stripe las custodia.
  stripeConnectAccountId        String?  @unique // acct_...
  stripeConnectChargesEnabled   Boolean  @default(false) // puede aceptar cobros
  stripeConnectPayoutsEnabled   Boolean  @default(false) // puede recibir liquidaciones
  stripeConnectDetailsSubmitted Boolean  @default(false) // completó el onboarding de Stripe

  // Pasarela de pago ACTIVA de la tienda: "none" | "stripe" | "redsys" (extensible a otras).
  paymentProvider               String   @default("none")
  // Redsys (TPV virtual español). El secreto (clave SHA-256) se guarda CIFRADO (AES-256-GCM);
  // nunca en claro. El código de comercio y el terminal no son secretos.
  redsysMerchantCode            String?
  redsysTerminal                String?
  redsysEnvironment             String?  // "test" | "live"
  redsysSecretKeyEnc            String?  // clave secreta cifrada (no es el valor en claro)

  // AI Credits Limits
  aiCredits              Int      @default(0) // Credits are assigned on plan purchase or manually
  creditsResetDate       DateTime?

  @@index([siteJobId])
  @@index([creditsResetDate])
}

// Registro de eventos de Stripe ya procesados para garantizar idempotencia
// (Stripe puede reenviar el mismo evento varias veces — replay safety).
model StripeEvent {
  id          String   @id // event.id de Stripe (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// Cuentas de correo corporativo asociadas al dominio del usuario.
model EmailAccount {
  id           Int      @id @default(autoincrement())
  userId       Int
  address      String   @unique // dirección completa local@dominio
  localPart    String
  domain       String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Consumo de tokens/coste de IA por llamada, para contabilidad por job y por usuario.
model JobUsage {
  id           Int      @id @default(autoincrement())
  jobId        String
  userId       Int?
  kind         String   // "generation" | "edit"
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  creditsUsed  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([userId])
}

// Enterprise Credit Ledger para evitar pérdida de datos en el saldo
model CreditTransaction {
  id          String   @id @default(uuid())
  userId      Int
  amount      Int      // Positivo (añade créditos), Negativo (deduce)
  reason      String   // e.g. "Monthly Plan Basic", "Admin Adjustment", "JobUsage: job_id"
  metadata    String?  // JSON with extra details
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Control de Sesiones de Dispositivos Activas (Enterprise Level)
model Session {
  id         String   @id @default(uuid())
  userId     Int
  token      String   @unique
  userAgent  String?
  ipAddress  String?
  location   String?
  deviceType String?  // "Desktop" | "Mobile" | "Tablet"
  browser    String?  // "Chrome" | "Safari" | "Firefox" | "Edge" | etc.
  os         String?  // "Windows" | "macOS" | "Linux" | "iOS" | "Android" | etc.
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

