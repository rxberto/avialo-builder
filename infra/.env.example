# ==========================================
# VARIABLES DE ENTORNO DE PRODUCCIÓN (AVIALO)
# ==========================================

# Puerto del orquestador backend
PORT=3000

# URL del frontend (usada para CORS y para las return/cancel URLs de Stripe)
FRONTEND_URL=https://avialo.app
# Allowlist de orígenes CORS separada por comas (opcional; por defecto usa FRONTEND_URL + localhost)
CORS_ORIGINS=https://avialo.app,https://www.avialo.app

# Base de datos PostgreSQL local
DB_USER=postgres
DB_PASSWORD=postgres_contrasena_ultra_segura
DB_NAME=postgres

# Worker de generación (proceso separado de la API)
# Concurrencia de generaciones simultáneas. En droplets pequeños mantener en 1 (cada build
# levanta un contenedor de hasta 2GB).
GENERATION_CONCURRENCY=1
# Techo de coste de IA por job (USD). Si una generación/edición lo supera, se aborta.
MAX_JOB_COST_USD=2.0
# Máximo de buzones de correo corporativo por usuario.
MAX_MAILBOXES_PER_USER=10
# Límites de memoria de los contenedores efímeros (en bytes). Ajustar al tamaño del droplet.
BUILD_MEMORY_BYTES=2147483648
RUNTIME_MEMORY_BYTES=268435456

# Ruta ABSOLUTA en el HOST de la carpeta sandbox (la que se monta en ../sandbox).
# El worker corre en contenedor pero crea contenedores hijos vía el Docker del host, y el
# daemon resuelve los binds contra el FS del host. DEBE coincidir con la ruta real del repo.
# Si clonaste en /root/avialo-builder, déjalo así:
SANDBOX_HOST_DIR=/root/avialo-builder/sandbox

# Base de dominio para las previsualizaciones de los sitios generados.
# El preview se enruta por Traefik en HTTPS como <slug>.<PREVIEW_DOMAIN_BASE>
# (ej: gastrorro.avialo.app). Requiere wildcard DNS *.avialo.app -> IP del servidor.
# Déjalo VACÍO solo en desarrollo local (entonces el preview va por localhost:puerto).
PREVIEW_DOMAIN_BASE=avialo.app

# API Keys para Modelos de Lenguaje (LLM)
# Se necesitan para que el Agente IA pueda escribir código de las webs de los clientes
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui
# Clave de Google Gemini. Nombre canónico GEMINI_API_KEY (GOOGLE_API_KEY también se acepta).
GEMINI_API_KEY=tu_clave_google_gemini_aqui
OPENAI_API_KEY=tu_clave_openai_aqui
OPENROUTER_API_KEY=tu_clave_openrouter_aqui
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui

# Proveedor primario forzado para la GENERACIÓN (claude|gemini|deepseek).
# Útil si solo tienes saldo en uno. Vacío = routing automático por tipo de tarea.
# OJO: si lo fijas, su API key correspondiente DEBE estar definida o la generación fallará.
LLM_PRIMARY=deepseek
# Modelo de DeepSeek (deepseek-chat por defecto; deepseek-coder para código).
DEEPSEEK_MODEL=deepseek-chat
# Modelo de OpenRouter usado como último salvavidas (los ids ":free" cambian a menudo).
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Stripe (Facturación y Suscripciones SaaS del portal)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secreto de firma del webhook de Stripe (Dashboard > Developers > Webhooks).
# Obligatorio para verificar y procesar eventos de pago/suscripción.
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT del orquestador (login del panel SaaS). OBLIGATORIO en producción (mín. 16 chars).
# Generar con: openssl rand -base64 32
JWT_SECRET=clave-jwt-secreta-de-32-caracteres-minimo

# NextAuth / Auth.js (Para inicio de sesión y cookies seguras)
# Generar una clave de 32 caracteres ejecutando: openssl rand -base64 32
NEXTAUTH_SECRET=clave-secreta-de-32-caracteres-minimo
NEXTAUTH_URL=https://avialo.app

# Observabilidad (opcional). Si SENTRY_DSN está vacío, el seguimiento de errores se desactiva.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# Openprovider — registro de dominios (.es a precio coste vía Membership)
# Docs: https://developers.openprovider.eu/
OPENPROVIDER_USERNAME=tu_usuario_openprovider
OPENPROVIDER_PASSWORD=tu_password_openprovider
# Handle de contacto/owner de Avialo ya creado en el panel (se reutiliza para todos los dominios)
OPENPROVIDER_OWNER_HANDLE=AB123456-ES
# Nameservers de Openprovider (DNS gestionado)
OPENPROVIDER_NS=ns1.openprovider.nl,ns2.openprovider.be,ns3.openprovider.eu
# IP del droplet a la que apuntan los registros A de los dominios de clientes
DNS_TARGET_IP=159.69.110.22

# Traefik / SSL Let's Encrypt / Wildcard DNS
# Si utilizas DNS Challenge con Cloudflare para certs wildcard (*.avialo.app)
CLOUDFLARE_EMAIL=tu_correo_cloudflare@dominio.com
CLOUDFLARE_DNS_API_TOKEN=tu_token_dns_api_cloudflare
