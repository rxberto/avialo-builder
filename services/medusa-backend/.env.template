# Backend Medusa compartido — variables de entorno.
# En producción las inyecta infra/docker-compose.yml; este fichero es la referencia.

NODE_ENV=production

# Base de datos DEDICADA de Medusa (NO compartir con los esquemas de tenants).
# Conexión DIRECTA a Postgres (no pgbouncer en modo transaction: Medusa usa prepared statements).
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa

# Redis compartido (cache + event-bus + workflow-engine).
REDIS_URL=redis://redis:6379

# CORS. STORE_CORS debe permitir los dominios de las tiendas de los clientes.
# Acepta lista separada por comas o regex (envuelta en /.../).
STORE_CORS=/\.avialo\.app$/
ADMIN_CORS=https://tienda-api.avialo.app
AUTH_CORS=https://tienda-api.avialo.app,/\.avialo\.app$/

# Secretos (generar en producción; NO usar estos valores).
JWT_SECRET=change_me
COOKIE_SECRET=change_me

# Stripe (checkout). Vacío = checkout deshabilitado. Usar sk_live_ / sk_test_.
STRIPE_API_KEY=

# Arranque automático: sembrar infraestructura base la primera vez.
MEDUSA_SEED_BASE=true

# Usuario admin inicial del panel Medusa (/app).
MEDUSA_ADMIN_EMAIL=admin@avialo.app
MEDUSA_ADMIN_PASSWORD=change_me
